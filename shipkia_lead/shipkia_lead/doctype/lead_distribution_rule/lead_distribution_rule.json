{
 "doctype": "DocType",
 "name": "Lead Distribution Rule",
 "module": "Shipkia Lead",
 "engine": "InnoDB",
 "field_order": [
  "enabled",
  "status",
  "slot_limit",
  "users",
  "last_error",
  "last_user",
  "dispatch_token",
  "dispatch_requested_at"
 ],
 "fields": [
  {
   "fieldname": "enabled",
   "fieldtype": "Check",
   "label": "Enabled",
   "default": "0",
   "in_list_view": 1
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "options": "Lead\nOpen\nReplied\nOpportunity\nQuotation\nLost Quotation\nInterested",
   "label": "Lead Status",
   "reqd": 1,
   "in_list_view": 1,
   "description": "Leads in this status are distributed and counted against each user's slots.",
   "unique": 1
  },
  {
   "fieldname": "slot_limit",
   "fieldtype": "Int",
   "label": "Slots per User",
   "reqd": 1,
   "default": "5",
   "in_list_view": 1,
   "description": "Maximum active leads each user may hold in this status. Manual assignments count but are not blocked."
  },
  {
   "fieldname": "users",
   "fieldtype": "Table",
   "options": "Lead Distribution User",
   "label": "Users",
   "reqd": 1
  },
  {
   "fieldname": "last_error",
   "fieldtype": "Small Text",
   "label": "Last Error",
   "read_only": 1
  },
  {
   "fieldname": "last_user",
   "fieldtype": "Link",
   "options": "User",
   "label": "Last Assigned User",
   "read_only": 1
  },
  {
   "fieldname": "dispatch_token",
   "fieldtype": "Data",
   "hidden": 1,
   "read_only": 1
  },
  {
   "fieldname": "dispatch_requested_at",
   "fieldtype": "Datetime",
   "hidden": 1,
   "read_only": 1
  }
 ],
 "autoname": "field:status",
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1
  },
  {
   "role": "Sales Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1
  }
 ],
 "track_changes": 1
}
